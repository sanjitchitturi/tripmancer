# Postgres connection string. Required on Vercel.
# Leave empty in local development to use the embedded database in .data/.
DATABASE_URL=

# Optional. Links work without these. An ID only adds your affiliate tracking.

# Skyscanner Partners associate id. When set, flight buttons open Skyscanner.
# When empty, flight buttons open Google Flights.
NEXT_PUBLIC_SKYSCANNER_ID=

# Booking.com Affiliate Partner aid
NEXT_PUBLIC_BOOKING_AID=

# Agoda affiliate cid
NEXT_PUBLIC_AGODA_CID=

# Klook affiliate aid
NEXT_PUBLIC_KLOOK_AID=

# Full URL from your insurance partner. Defaults to SafetyWing.
NEXT_PUBLIC_INSURANCE_URL=

# Full URL from your eSIM partner. Defaults to Airalo.
NEXT_PUBLIC_ESIM_URL=

# Full URL from your travel-money partner. Defaults to Wise.
NEXT_PUBLIC_FOREX_URL=

# Optional rail partner URL. When empty, train buttons open Rome2Rio.
NEXT_PUBLIC_RAIL_URL=

# Public HTTPS origin used by the deployed app behind a proxy.
# Leave unset locally.
# APP_ORIGIN=https://your-project.vercel.app

# Optional provider-supplied PEM root certificate for verified Postgres TLS.
# DATABASE_CA_CERT=

# Optional local-only path for persistent embedded data.
# PGLITE_DIR=

# Public contact address displayed in the privacy notice for privacy requests.
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Google OpenID Connect sign-in. Create a Web application OAuth client in Google Cloud,
# register https://your-public-origin/api/auth/google/callback exactly, and keep the secret
# in the hosting provider only. The sign-in button appears automatically when both values exist.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
